# Optional. In dev, Vite proxies /api/* to http://localhost:8000 (see
# vite.config.ts) so you don't need this at all locally — just run the
# FastAPI backend (api/) and this frontend side by side.
#
# Set this only for a production deploy, pointing at your deployed
# backend's real URL (e.g. your Railway/Render app):
# VITE_API_BASE_URL=https://your-backend.up.railway.app
